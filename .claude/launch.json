{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dizzit-ai",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3010
    },
    {
      "name": "dizzit-ai-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3011"],
      "port": 3011
    },
    {
      "name": "dizzit-ai-auto",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_DIST_DIR=.next-preview", "npx", "next", "dev"],
      "autoPort": true,
      "port": 3012
    }
  ]
}
